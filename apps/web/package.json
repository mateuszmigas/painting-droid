{
  "name": "@painting-droid/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check-types": "tsc --noEmit",
    "check-types:watch": "tsc --noEmit --watch",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:debug": "pnpm exec playwright test --debug",
    "test:e2e:serve": "E2E_TESTS=true vite build && vite preview",
    "test:e2e:install-browsers": "pnpm exec playwright install --with-deps",
    "analyze-bundle": "pnpm dlx vite-bundle-visualizer"
  },
